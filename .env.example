# Gemini API key (server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL
APP_URL="MY_APP_URL"

# Pharmacy business settings
POCHI_BUSINESS_NUMBER="07417758578"
DOCTOR_PHONE="07417758578"

# Server-side JWT signing secret. Configure the real value only in Vercel.
JWT_SECRET=

# Server-side admin password used only to initialize the admin account.
ADMIN_PASSWORD=

# Optional server-side pharmacist password. Leave empty to omit the seeded pharmacist account.
PHARMACIST_PASSWORD=

# Security hardening branch verification trigger.
